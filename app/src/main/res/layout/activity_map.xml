<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 顶部 AppBar：标题 + 菜单 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.MaterialComponents.Toolbar.Primary"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="送件"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:menu="@menu/map_menu" />

    <!-- 全屏地图 -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- 左上角状态概览卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="?attr/actionBarSize"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_gravity="top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_status_delivered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已送: 0"
                android:layout_marginEnd="18dp"
                style="@style/TextAppearance.MaterialComponents.Body2" />

            <TextView
                android:id="@+id/tv_status_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="等送: 0"
                android:layout_marginEnd="18dp"
                style="@style/TextAppearance.MaterialComponents.Body2" />

            <TextView
                android:id="@+id/tv_status_uploading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上传中: 0"
                android:layout_marginEnd="18dp"
                style="@style/TextAppearance.MaterialComponents.Body2" />

            <TextView
                android:id="@+id/tv_status_failed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="失败: 0"
                style="@style/TextAppearance.MaterialComponents.Body2" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 右下角 切换 列表/地图 按钮 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_toggle_mode"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="90dp"
        android:layout_gravity="bottom|end"
        app:backgroundTint="@color/colorPrimary"
        app:srcCompat="@drawable/ic_view_list"
        android:contentDescription="切换列表/地图" />

    <!-- 地图加载时的进度指示 -->
    <ProgressBar
        android:id="@+id/progress_map"
        style="@style/Widget.AppCompat.ProgressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
