<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 顶部 AppBar：标题 + 菜单 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.MaterialComponents.Toolbar.Primary"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="送件"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:menu="@menu/map_menu" />

    <!-- 全屏地图 -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- 右侧中部 Mini Bar（列表 / 定位 / 地图类型） -->
    <include
        android:id="@+id/include_minibar"
        layout="@layout/include_map_minibar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp" />


    <!-- Transparent compact status overlay (floats over the map) -->
    <TextView
        android:id="@+id/tv_status_compact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="?attr/actionBarSize"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:fontFamily="monospace"
        android:text="0/0/0/0"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@android:color/black"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="3"
        android:background="@android:color/transparent"
        android:alpha="0.35"/>

    <!-- 右下角 切换 列表/地图 按钮 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_toggle_mode"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="90dp"
        android:layout_gravity="bottom|end"
        app:backgroundTint="@color/colorPrimary"
        app:srcCompat="@drawable/ic_view_list"
        android:contentDescription="切换列表/地图" />

    <!-- 地图加载时的进度指示 -->
    <ProgressBar
        android:id="@+id/progress_map"
        style="@style/Widget.AppCompat.ProgressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
