<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mapMiniBar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/bg_minibar_panel"
    android:alpha="0.95"
    android:elevation="6dp">

    <!-- 间隔 -->
    <Space
        android:layout_width="1dp"
        android:layout_height="8dp" />

    <!-- 回到当前位置 -->
    <ImageButton
        android:id="@+id/btn_my_loc"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/my_location"
        android:src="@android:drawable/ic_menu_mylocation"
        android:tint="@android:color/white" />

    <!-- 间隔 -->
    <Space
        android:layout_width="1dp"
        android:layout_height="8dp" />

    <!-- 地图类型切换（卫星/普通） -->
    <ImageButton
        android:id="@+id/btn_map_type"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/map_type_toggle"
        android:src="@android:drawable/ic_menu_mapmode"
        android:tint="@android:color/white" />

    <!-- 间隔 -->
    <Space
        android:layout_width="1dp"
        android:layout_height="8dp" />

    <!-- 全屏模式切换 -->
    <ImageButton
        android:id="@+id/btn_fullscreen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/fullscreen_mode"
        android:src="@drawable/ic_fullscreen_enter"
        android:tint="@android:color/white" />

</LinearLayout>
